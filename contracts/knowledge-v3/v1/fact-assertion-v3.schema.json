{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s9-knowledge/contracts/knowledge-v3/v1/fact-assertion-v3.schema.json",
  "title": "fact-assertion/v3-internal-v1",
  "description": "Unidad autoritativa del ledger temporal. La arista directa del grafo es una PROYECCION; la verdad vive aqui. La historia nunca se borra: se supersede.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id", "contract_version", "workspace", "source_asset_id", "source_hash",
    "provider_trace", "produced_by_step", "assertion_id", "subject_entity_id", "object_entity_id",
    "predicate", "direction", "valid_from", "valid_to", "recorded_at",
    "epistemic_status", "confidence", "status", "state", "event_time",
    "negated", "collection_id", "game_profile", "engine_version",
    "ontology_version", "evidence_fragment_ids", "episode_ids",
    "supersedes", "superseded_by"
  ],
  "properties": {
    "contract_id": { "const": "fact-assertion/v3-internal-v1" },
    "contract_version": { "$ref": "_common-v3.schema.json#/$defs/contract_version" },
    "workspace": { "$ref": "_common-v3.schema.json#/$defs/workspace" },
    "source_asset_id": { "$ref": "_common-v3.schema.json#/$defs/stable_id" },
    "source_hash": { "$ref": "_common-v3.schema.json#/$defs/hash" },
    "provider_trace": { "$ref": "_common-v3.schema.json#/$defs/provider_trace" },
    "produced_by_step": {
      "$ref": "_common-v3.schema.json#/$defs/stable_id",
      "description": "Paso de `provider_trace` que produjo el CONTENIDO principal de este documento. Referencia explicita: la atribucion de proveedor no puede depender de heuristicas sobre `produced`, porque una traza mal adivinada convierte una salida externa en 'local' sin que nadie se entere."
    },

    "assertion_id": { "$ref": "_common-v3.schema.json#/$defs/stable_id" },
    "subject_entity_id": { "$ref": "_common-v3.schema.json#/$defs/stable_id" },
    "object_entity_id": { "$ref": "_common-v3.schema.json#/$defs/stable_id" },
    "predicate": { "$ref": "_common-v3.schema.json#/$defs/predicate" },
    "direction": { "$ref": "_common-v3.schema.json#/$defs/direction" },
    "valid_from": { "$ref": "_common-v3.schema.json#/$defs/iso8601_utc_or_null" },
    "valid_to": { "$ref": "_common-v3.schema.json#/$defs/iso8601_utc_or_null" },
    "recorded_at": { "$ref": "_common-v3.schema.json#/$defs/iso8601_utc" },
    "epistemic_status": { "$ref": "_common-v3.schema.json#/$defs/epistemic_status" },
    "confidence": { "$ref": "_common-v3.schema.json#/$defs/confidence" },
    "status": {
      "type": "string",
      "description": "Eje de CICLO DE VIDA en el ledger. Nada que ver con `state`, que es el eje temporal.",
      "enum": ["PROVISIONAL", "ASSERTED", "CONFIRMED", "LIMITED", "SUPERSEDED", "CONTRADICTED", "RETRACTED"]
    },
    "state": { "$ref": "_common-v3.schema.json#/$defs/assertion_state" },
    "event_time": {
      "$ref": "_common-v3.schema.json#/$defs/iso8601_utc_or_null",
      "description": "Momento del HECHO narrado, distinto de valid_from/valid_to (vigencia) y de recorded_at (cuando lo supo el sistema)."
    },
    "calendar_id": {
      "$ref": "_common-v3.schema.json#/$defs/stable_id_or_null",
      "description": "Calendario del mundo de juego en el que se expresan valid_from/valid_to/event_time."
    },
    "collection_id": { "$ref": "_common-v3.schema.json#/$defs/stable_id" },
    "game_profile": { "$ref": "_common-v3.schema.json#/$defs/game_profile" },
    "engine_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "ontology_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "evidence_fragment_ids": {
      "type": "array",
      "minItems": 1,
      "description": "Sin evidencia no hay afirmacion. Nunca vacio.",
      "items": { "$ref": "_common-v3.schema.json#/$defs/stable_id" }
    },
    "episode_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "_common-v3.schema.json#/$defs/stable_id" }
    },
    "supersedes": { "$ref": "_common-v3.schema.json#/$defs/stable_id_or_null" },
    "superseded_by": { "$ref": "_common-v3.schema.json#/$defs/stable_id_or_null" },
    "local_override_of": {
      "$ref": "_common-v3.schema.json#/$defs/stable_id_or_null",
      "description": "M4 (docs/v3/49): puntero NO DESTRUCTIVO al assertion_id de capa juego del que esta afirmacion de partida diverge (razon LOCAL_DIVERGENCE). A diferencia de superseded_by, jamas implica una mutacion del documento apuntado."
    },
    "negated": {
      "type": "boolean",
      "description": "Obligatorio y explicito: la ausencia de negacion no puede quedar implicita en un contrato de hechos."
    },
    "metadata": { "$ref": "_common-v3.schema.json#/$defs/metadata" }
  },
  "allOf": [
    {
      "$comment": "Una afirmacion superada DEBE decir quien la supera; si no, la historia se pierde.",
      "if": { "properties": { "status": { "const": "SUPERSEDED" } }, "required": ["status"] },
      "then": {
        "properties": { "superseded_by": { "$ref": "_common-v3.schema.json#/$defs/stable_id" } },
        "required": ["superseded_by"]
      }
    },
    {
      "$comment": "Un hecho planificado no puede estar ya terminado ni tener vigencia cerrada en el pasado del propio evento; la coherencia fina la comprueba el validador.",
      "if": { "properties": { "state": { "const": "PLANNED" } }, "required": ["state"] },
      "then": { "properties": { "status": { "not": { "const": "CONFIRMED" } } } }
    }
  ]
}
