{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s9-knowledge/contracts/knowledge-v3/v1/graph-mutation-plan-v3.schema.json",
  "title": "graph-mutation-plan/v3-internal-v1",
  "description": "UNICA entrada admisible del writer. Lo produce el motor local; ningun proveedor externo puede producirlo ni firmarlo. El writer no interpreta, no corrige, no consulta modelos: solo ejecuta un plan local valido, firmado, idempotente y con hash comprobable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id", "contract_version", "workspace", "source_asset_id", "source_hash",
    "provider_trace", "plan_id", "plan_hash", "engine_version", "ontology_version",
    "game_profile", "collection_id", "created_at", "expires_at", "decisions",
    "mutation_operations", "local_approval"
  ],
  "properties": {
    "contract_id": { "const": "graph-mutation-plan/v3-internal-v1" },
    "contract_version": { "$ref": "_common-v3.schema.json#/$defs/contract_version" },
    "workspace": { "$ref": "_common-v3.schema.json#/$defs/workspace" },
    "source_asset_id": { "$ref": "_common-v3.schema.json#/$defs/stable_id" },
    "source_hash": { "$ref": "_common-v3.schema.json#/$defs/hash" },
    "provider_trace": { "$ref": "_common-v3.schema.json#/$defs/provider_trace" },

    "plan_id": { "$ref": "_common-v3.schema.json#/$defs/stable_id" },
    "plan_hash": {
      "$ref": "_common-v3.schema.json#/$defs/hash",
      "description": "sha256 del JSON canonico del plan SIN este campo. Cualquier modificacion posterior (workspace, source_hash, operacion, decision) lo invalida."
    },
    "engine_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "ontology_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "game_profile": { "$ref": "_common-v3.schema.json#/$defs/game_profile" },
    "collection_id": { "$ref": "_common-v3.schema.json#/$defs/stable_id" },
    "created_at": { "$ref": "_common-v3.schema.json#/$defs/iso8601_utc" },
    "expires_at": {
      "$ref": "_common-v3.schema.json#/$defs/iso8601_utc",
      "description": "Un plan caduca. El writer rechaza un plan expirado aunque su firma sea correcta."
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/decision" }
    },
    "mutation_operations": {
      "type": "array",
      "items": { "$ref": "#/$defs/mutation_operation" }
    },
    "local_approval": { "$ref": "#/$defs/local_approval" },
    "metadata": { "$ref": "_common-v3.schema.json#/$defs/metadata" }
  },
  "allOf": [
    {
      "$comment": "Un plan aprobado sin operaciones no tiene sentido; y aprobado exige cadena de validadores.",
      "if": {
        "properties": { "local_approval": { "properties": { "approved": { "const": true } }, "required": ["approved"] } },
        "required": ["local_approval"]
      },
      "then": { "properties": { "mutation_operations": { "minItems": 1 } } }
    }
  ],
  "$defs": {
    "decision": {
      "type": "object",
      "description": "Decision del motor local sobre un ClaimProposal. ABSTAIN y REVIEW son salidas legitimas; REJECT_INVALID solo para incompatibilidades demostrables.",
      "additionalProperties": false,
      "required": ["decision_id", "claim_id", "decision", "confidence", "reason_codes", "evidence_fragment_ids"],
      "properties": {
        "decision_id": { "$ref": "_common-v3.schema.json#/$defs/stable_id" },
        "claim_id": { "$ref": "_common-v3.schema.json#/$defs/stable_id" },
        "decision": { "type": "string", "enum": ["ACCEPT", "REJECT_INVALID", "ABSTAIN", "REVIEW"] },
        "predicate": {
          "anyOf": [
            { "$ref": "_common-v3.schema.json#/$defs/predicate" },
            { "type": "null" }
          ]
        },
        "direction": {
          "anyOf": [
            { "$ref": "_common-v3.schema.json#/$defs/direction" },
            { "type": "null" }
          ]
        },
        "subject_entity_id": { "$ref": "_common-v3.schema.json#/$defs/stable_id_or_null" },
        "object_entity_id": { "$ref": "_common-v3.schema.json#/$defs/stable_id_or_null" },
        "epistemic_status": { "$ref": "_common-v3.schema.json#/$defs/epistemic_status" },
        "negated": { "type": "boolean" },
        "confidence": { "$ref": "_common-v3.schema.json#/$defs/confidence" },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "_common-v3.schema.json#/$defs/reason_code" }
        },
        "evidence_fragment_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "_common-v3.schema.json#/$defs/stable_id" }
        }
      },
      "allOf": [
        {
          "$comment": "ACCEPT exige predicado, direccion, sujeto y objeto resueltos. Aceptar sin ellos seria escribir a ciegas.",
          "if": { "properties": { "decision": { "const": "ACCEPT" } }, "required": ["decision"] },
          "then": {
            "required": ["predicate", "direction", "subject_entity_id", "object_entity_id"],
            "properties": {
              "predicate": { "$ref": "_common-v3.schema.json#/$defs/predicate" },
              "direction": { "$ref": "_common-v3.schema.json#/$defs/direction" },
              "subject_entity_id": { "$ref": "_common-v3.schema.json#/$defs/stable_id" },
              "object_entity_id": { "$ref": "_common-v3.schema.json#/$defs/stable_id" }
            }
          }
        }
      ]
    },
    "mutation_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "operation_type", "decision_id", "payload", "evidence_fragment_ids", "idempotency_key", "expected_state"],
      "properties": {
        "operation_id": { "$ref": "_common-v3.schema.json#/$defs/stable_id" },
        "operation_type": {
          "type": "string",
          "enum": ["CREATE_ENTITY", "UPDATE_ENTITY", "LINK_EXISTING", "CREATE_ASSERTION", "SUPERSEDE_ASSERTION", "PROJECT_RELATION"]
        },
        "decision_id": { "$ref": "_common-v3.schema.json#/$defs/stable_id" },
        "target_entity_id": { "$ref": "_common-v3.schema.json#/$defs/stable_id_or_null" },
        "assertion_id": { "$ref": "_common-v3.schema.json#/$defs/stable_id_or_null" },
        "payload": {
          "type": "object",
          "description": "EXCEPCION DOCUMENTADA a additionalProperties:false: el payload depende del tipo de operacion y de la ontologia activa. El validador prohibe claves sensibles en su interior.",
          "additionalProperties": true
        },
        "evidence_fragment_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "_common-v3.schema.json#/$defs/stable_id" }
        },
        "idempotency_key": {
          "$ref": "_common-v3.schema.json#/$defs/stable_id",
          "description": "Unica dentro del plan. Reaplicar el plan no puede duplicar nada."
        },
        "expected_state": {
          "type": "string",
          "enum": ["WOULD_CREATE", "WOULD_UPDATE", "WOULD_LINK_EXISTING", "WOULD_SUPERSEDE", "NO_OP"]
        }
      }
    },
    "local_approval": {
      "type": "object",
      "description": "Firma local. approved_by.provider es SIEMPRE 'local': un plan firmado por ollama o por un proveedor externo es invalido por contrato, no por politica.",
      "additionalProperties": false,
      "required": ["approved", "decision_hash", "validator_chain", "created_at", "approved_by"],
      "properties": {
        "approved": { "type": "boolean" },
        "decision_hash": {
          "$ref": "_common-v3.schema.json#/$defs/hash",
          "description": "sha256 del cuerpo de decision (workspace + source_hash + versiones + perfil + decisions + mutation_operations)."
        },
        "validator_chain": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["validator", "version", "result"],
            "properties": {
              "validator": { "type": "string", "minLength": 1, "maxLength": 128 },
              "version": { "type": "string", "minLength": 1, "maxLength": 64 },
              "result": { "type": "string", "enum": ["PASS", "FAIL", "SKIPPED"] },
              "reason_codes": { "type": "array", "items": { "$ref": "_common-v3.schema.json#/$defs/reason_code" } }
            }
          }
        },
        "created_at": { "$ref": "_common-v3.schema.json#/$defs/iso8601_utc" },
        "approved_by": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "name", "version"],
          "properties": {
            "provider": { "const": "local" },
            "name": { "type": "string", "minLength": 1, "maxLength": 128 },
            "version": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        }
      }
    }
  }
}
