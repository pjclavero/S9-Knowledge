{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s9-knowledge/contracts/knowledge-v3/v1/entity-mention-v3.schema.json",
  "title": "entity-mention/v3-internal-v1",
  "description": "Mencion de una entidad dentro de un episodio. NO decide identidad: solo propone tipos y correferencias candidatas.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id", "contract_version", "workspace", "source_asset_id", "source_hash",
    "provider_trace", "produced_by_step", "mention_id", "episode_id", "surface", "normalized_surface",
    "start", "end", "bbox", "time_start", "time_end", "type_candidates",
    "confidence", "coreference_candidates", "evidence_fragment_ids"
  ],
  "properties": {
    "contract_id": { "const": "entity-mention/v3-internal-v1" },
    "contract_version": { "$ref": "_common-v3.schema.json#/$defs/contract_version" },
    "workspace": { "$ref": "_common-v3.schema.json#/$defs/workspace" },
    "source_asset_id": { "$ref": "_common-v3.schema.json#/$defs/stable_id" },
    "source_hash": { "$ref": "_common-v3.schema.json#/$defs/hash" },
    "provider_trace": { "$ref": "_common-v3.schema.json#/$defs/provider_trace" },
    "produced_by_step": {
      "$ref": "_common-v3.schema.json#/$defs/stable_id",
      "description": "Paso de `provider_trace` que produjo el CONTENIDO principal de este documento. Referencia explicita: la atribucion de proveedor no puede depender de heuristicas sobre `produced`, porque una traza mal adivinada convierte una salida externa en 'local' sin que nadie se entere."
    },

    "mention_id": { "$ref": "_common-v3.schema.json#/$defs/stable_id" },
    "episode_id": { "$ref": "_common-v3.schema.json#/$defs/stable_id" },
    "surface": { "type": "string", "minLength": 1, "maxLength": 512 },
    "normalized_surface": { "type": "string", "minLength": 1, "maxLength": 512 },
    "start": { "type": "integer", "minimum": 0 },
    "end": { "type": "integer", "minimum": 0 },
    "bbox": { "$ref": "_common-v3.schema.json#/$defs/bbox_or_null" },
    "time_start": { "$ref": "_common-v3.schema.json#/$defs/seconds_or_null" },
    "time_end": { "$ref": "_common-v3.schema.json#/$defs/seconds_or_null" },
    "type_candidates": {
      "type": "array",
      "description": "Tipos candidatos con su confianza. Puede estar vacio: no tipar es preferible a tipar mal.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "confidence"],
        "properties": {
          "type": { "$ref": "_common-v3.schema.json#/$defs/entity_type" },
          "confidence": { "$ref": "_common-v3.schema.json#/$defs/confidence" }
        }
      }
    },
    "confidence": { "$ref": "_common-v3.schema.json#/$defs/confidence" },
    "coreference_candidates": {
      "type": "array",
      "items": { "$ref": "_common-v3.schema.json#/$defs/stable_id" }
    },
    "evidence_fragment_ids": {
      "type": "array",
      "minItems": 1,
      "description": "Una mencion sin evidencia anclada no existe.",
      "items": { "$ref": "_common-v3.schema.json#/$defs/stable_id" }
    },
    "metadata": { "$ref": "_common-v3.schema.json#/$defs/metadata" }
  }
}
