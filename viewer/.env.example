S9K_VIEWER_HOST=127.0.0.1
S9K_VIEWER_PORT=8088
S9K_GRAPH_PROVIDER=mock
S9K_DEFAULT_WORKSPACE=leyenda
S9K_GRAPH_LIMIT=300

# Solo para provider neo4j (no probado aún desde local; VM105 queda intacta).
S9K_NEO4J_URI=bolt://192.168.1.205:7687
S9K_NEO4J_USER=neo4j
S9K_NEO4J_PASSWORD=
S9K_NEO4J_PASSWORD_FILE=

# --- Autenticación del visor (instalación cerrada de fábrica) ---
# ACTIVADA por defecto: una instalación nueva que copie este fichero a `.env`
# y arranque sin tocar nada más queda con login/sesiones/roles exigidos.
# `false` sigue existiendo como opt-out EXPLÍCITO para desarrollo o
# laboratorio (sin login, comportamiento previo a este corte); ponerlo aquí
# a mano es una decisión deliberada de quien instala, no el punto de partida.
S9K_AUTH_ENABLED=true
# Ruta de la base de datos SQLite de autenticación. Vacío -> se resuelve sola
# a una ruta absoluta dentro del propio repo (<repo>/viewer/state/auth.db);
# no hace falta fijarla para que el arranque de fábrica funcione.
S9K_AUTH_DB_PATH=
# Nombre de la cookie de sesión
S9K_SESSION_COOKIE_NAME=s9k_session
# Duración máxima de la sesión en horas
S9K_SESSION_TTL_HOURS=12
# Expiración por inactividad en minutos (0 = sin límite de inactividad)
S9K_SESSION_IDLE_MINUTES=60
# Poner en false solo en desarrollo local sin HTTPS
S9K_SESSION_SECURE=true
S9K_SESSION_SAMESITE=lax
# Número máximo de intentos de login antes de bloquear la cuenta
S9K_AUTH_MAX_FAILED_ATTEMPTS=5
# Minutos que dura el bloqueo por intentos fallidos
S9K_AUTH_LOCK_MINUTES=15
# Exponer /docs, /redoc y /openapi.json. Por defecto NO se registran. Cuando
# es true y auth está activa, solo el rol admin puede verlos (anónimo → 401).
S9K_AUTH_EXPOSE_DOCS=false
# Confiar en X-Forwarded-For / X-Forwarded-Proto (solo si el reverse proxy es de confianza)
S9K_AUTH_TRUST_PROXY_HEADERS=false
# Secreto CSRF. Vacío -> se genera SOLO, la primera vez que arranca, y se
# persiste en disco (junto a la auth DB, permisos 0600, fuera del repo): no
# hace falta abrir un terminal para tener una instalación de fábrica segura.
# El valor generado NUNCA se imprime (ni logs, ni UI, ni errores).
# Fijarlo aquí a mano sigue siendo válido y tiene prioridad (por ejemplo, para
# compartir el mismo secreto entre varias instancias detrás de un balanceador):
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
# No commitear nunca el valor real; este fichero es una PLANTILLA pública.
S9K_CSRF_SECRET=

# --- Paneles del chasis (huecos C/B/F/G, ver docs/69) ---
# Un interruptor por panel. FALLA CERRADO: sólo `true` o `1` encienden un
# panel; ausente, vacío, `false` o cualquier otro valor lo dejan apagado (404).
# Por defecto están los cuatro apagados: hoy sirven una pantalla vacía y no hay
# ninguna razón para exponerlos hasta que su carril los termine.
S9K_PANEL_C_ENABLED=false
S9K_PANEL_B_ENABLED=false
S9K_PANEL_F_ENABLED=false
S9K_PANEL_G_ENABLED=false

# --- Consola de operador: catálogo de fuentes ingeribles (ver docs/86) ---
# Directorio del que salen las fuentes que el operador puede elegir en
# `/panel/operations`. El operador NO lo escribe ni lo ve: sólo elige de una
# lista por nombre. Si no se define, se usa `examples/ingesta-v3` del
# repositorio, que es el material de prueba del Corte 1.
#
# OJO: la capacidad de alta de fuente vive en el hueco B, así que sigue
# apagada mientras `S9K_PANEL_B_ENABLED` no sea `true`.
#S9K_INGEST_SOURCES_DIR=/ruta/a/las/fuentes
