S9K_VIEWER_HOST=127.0.0.1
S9K_VIEWER_PORT=8088
S9K_GRAPH_PROVIDER=mock
S9K_DEFAULT_WORKSPACE=leyenda
S9K_GRAPH_LIMIT=300

# Solo para provider neo4j (no probado aún desde local; VM105 queda intacta).
# Plantilla PUBLICA: valor de documentacion (RFC 5737), nunca una IP interna
# real. Sustituyelo por el host real de tu instalacion en tu `.env` local.
S9K_NEO4J_URI=bolt://192.0.2.10:7687
S9K_NEO4J_USER=neo4j
S9K_NEO4J_PASSWORD=
S9K_NEO4J_PASSWORD_FILE=

# --- Autenticación del visor (instalación cerrada de fábrica) ---
# ACTIVADA por defecto: una instalación nueva que copie este fichero a `.env`
# y arranque sin tocar nada más queda con login/sesiones/roles exigidos.
# `false` sigue existiendo como opt-out EXPLÍCITO para desarrollo o
# laboratorio (sin login, comportamiento previo a este corte); ponerlo aquí
# a mano es una decisión deliberada de quien instala, no el punto de partida.
S9K_AUTH_ENABLED=true
# Ruta de la base de datos SQLite de autenticación. Vacío -> se resuelve sola
# a una ruta absoluta dentro del propio repo (<repo>/viewer/state/auth.db);
# no hace falta fijarla para que el arranque de fábrica funcione.
S9K_AUTH_DB_PATH=
# Nombre de la cookie de sesión
S9K_SESSION_COOKIE_NAME=s9k_session
# Duración máxima de la sesión en horas
S9K_SESSION_TTL_HOURS=12
# Expiración por inactividad en minutos (0 = sin límite de inactividad)
S9K_SESSION_IDLE_MINUTES=60
# Poner en false solo en desarrollo local sin HTTPS
S9K_SESSION_SECURE=true
S9K_SESSION_SAMESITE=lax
# Número máximo de intentos de login antes de bloquear la cuenta
S9K_AUTH_MAX_FAILED_ATTEMPTS=5
# Minutos que dura el bloqueo por intentos fallidos
S9K_AUTH_LOCK_MINUTES=15
# Exponer /docs, /redoc y /openapi.json. Por defecto NO se registran. Cuando
# es true y auth está activa, solo el rol admin puede verlos (anónimo → 401).
S9K_AUTH_EXPOSE_DOCS=false
# Confiar en X-Forwarded-For / X-Forwarded-Proto (solo si el reverse proxy es de confianza)
S9K_AUTH_TRUST_PROXY_HEADERS=false
# Secreto CSRF. Vacío -> se genera SOLO, la primera vez que arranca, y se
# persiste en disco (junto a la auth DB, permisos 0600): no hace falta abrir
# un terminal para tener una instalación de fábrica segura. El fichero
# generado vive dentro del árbol del repo (state/, cubierto por .gitignore:
# nunca entra en git), así que un tar/zip/rsync del directorio SÍ lo incluye;
# excluir state/ de cualquier copia o backup que no sea git.
# El valor generado NUNCA se imprime (ni logs, ni UI, ni errores).
# Fijarlo aquí a mano sigue siendo válido y tiene prioridad (por ejemplo, para
# compartir el mismo secreto entre varias instancias detrás de un balanceador):
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
# No commitear nunca el valor real; este fichero es una PLANTILLA pública.
S9K_CSRF_SECRET=

# --- Paneles del chasis (huecos C/B/F/G, ver docs/69) ---
# Un interruptor por panel. FALLA CERRADO: sólo `true` o `1` encienden un
# panel; ausente, vacío, `false` o cualquier otro valor lo dejan apagado (404).
# Por defecto están los cuatro apagados: hoy sirven una pantalla vacía y no hay
# ninguna razón para exponerlos hasta que su carril los termine.
#
# ESTE FICHERO SÍ los gobierna: poner aquí `true` y reiniciar enciende el
# panel, exactamente igual que S9K_AUTH_ENABLED más arriba. La única variable
# que manda por encima de este valor es la del ENTORNO del proceso (una que
# el propio operador exporta a mano, o la que fija systemd/EnvironmentFile en
# un despliegue real) — si esa variable de entorno existe, gana ella, aunque
# sea a cadena vacía; `.env` sólo se consulta cuando el entorno no dice nada.
S9K_PANEL_C_ENABLED=false
S9K_PANEL_B_ENABLED=false
S9K_PANEL_F_ENABLED=false
S9K_PANEL_G_ENABLED=false

# Pantallas de RESULTADO de una ejecución y su procedencia (`/panel/resultado`,
# ver `viewer/app/routers/resultado.py`). NO es un quinto hueco del chasis
# C/B/F/G (prefijo y router propios), pero usa la MISMA semántica de
# interruptor descrita arriba: sólo `true`/`1` la encienden, y este fichero la
# gobierna con la misma precedencia (entorno del proceso > `.env` > apagado).
# Apagada por defecto.
#
# TECHO DECLARADO: apagada (404 "apagado") y encendida-pero-pidiendo-un-
# identificador-inexistente (404 "no encontrado") son INDISTINGUIBLES por
# diseño -mismo código, mismo cuerpo de respuesta, a propósito (ver
# `resultado.py`: "un recurso no autorizado es indistinguible de uno
# inexistente")-. Sin un `apply_id` real ya existente en un almacén de
# procedencia, no hay forma de OBSERVAR por HTTP que esta clave concreta
# gobierna la pantalla; sólo se ha ejercido a nivel de unidad
# (`_encendido()` directo). No se declara probado por HTTP end-to-end.
S9K_PANEL_RESULTADO_ENABLED=false

# --- Consola de operador: catálogo de fuentes ingeribles (ver docs/86) ---
# Raíz del árbol de bóvedas (el montaje rclone). Su presencia enciende el modo
# bóveda: descubrimiento jerárquico de partidas/carpetas de juego y
# clasificación de ámbito. Sin ella (y sin S9K_INGEST_SOURCES_DIR más abajo),
# el catálogo cae en `examples/ingesta-v3` del repositorio, que es material de
# EJEMPLO y no una bóveda declarada: no gobierna ningún ámbito real.
#
# ESTE FICHERO SÍ la gobierna, con la MISMA precedencia que S9K_AUTH_ENABLED y
# los S9K_PANEL_*: la única variable que manda por encima es la del ENTORNO
# del proceso (export a mano, o EnvironmentFile de systemd en un despliegue
# real) — si esa variable de entorno existe, gana ella, aunque sea a cadena
# vacía; `.env` sólo se consulta cuando el entorno no dice nada.
#S9K_VAULT_ROOT=/ruta/al/arbol/de/bovedas

# Exigir que S9K_VAULT_ROOT sea un montaje activo (y no sólo un directorio
# local). Por defecto SÍ se exige. Poner en `0`/`false`/`no` sólo para
# laboratorio o suites donde la raíz es un directorio local sin montaje real.
# Misma precedencia que el resto de este fichero.
#S9K_VAULT_REQUIRE_MOUNT=1

# Directorio del que salen las fuentes cuando NO hay árbol de bóvedas
# (S9K_VAULT_ROOT sin definir): un único directorio plano, sin estructura de
# bóveda, que el operador puede elegir en `/panel/operations`. El operador NO
# lo escribe ni lo ve: sólo elige de una lista por nombre. Si tampoco se
# define esto, se usa `examples/ingesta-v3` del repositorio, que es el
# material de prueba del Corte 1 y NO es una bóveda declarada (ver
# `SOURCE_WORKSPACE_UNDECLARED` en `panel_errors.py`).
#
# Misma precedencia que S9K_VAULT_ROOT: entorno del proceso > este fichero.
#
# OJO: la capacidad de alta de fuente vive en el hueco B, así que sigue
# apagada mientras `S9K_PANEL_B_ENABLED` no sea `true`.
#S9K_INGEST_SOURCES_DIR=/ruta/a/las/fuentes
