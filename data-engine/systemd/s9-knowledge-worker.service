# UNIDAD CANONICA del worker de la cola de jobs (B3 · USABLE-V1 · H-02).
#
# UNA SOLA FUENTE. Este fichero es la unica plantilla de la unidad: lo instala
# `deploy/scripts/deploy.sh` (pasos 7-13) y lo instala el rol Ansible
# `systemd` COPIANDO ESTE MISMO FICHERO desde la release activa. No hay una
# segunda version en Jinja: es exactamente lo que produjo H-08 con el visor
# (dos unidades, una con `User=` y otra sin el).
#
# Lo que hace: `--loop` (DAEMON: una cola vacia no lo termina), libera los
# jobs huerfanos de un worker muerto gastando un intento
# (`--release-stale-seconds`) y reintenta los fallos transitorios con
# retroceso (`--retry-backoff-seconds`). `Restart=always` lo devuelve si muere.
#
# Usuario: `s9knowledge` (H-06 + H-08: usuario de sistema dedicado, el MISMO
# que el visor, el healthcheck y el dueño del estado privado), NO root y NO
# www-data. Las cifras (usuario, grupo, UMask, state root) las fija UNA
# autoridad, `data-engine/app/knowledge_v3/service_state.py`; `deploy.sh` lee
# la identidad de ELLA (no de esta unidad) y un test estructural compara esta
# unidad con ella; Ansible comprueba que coincide con `s9k_service_user`.
# `UMask=0077`: lo que escribe (propuestas, `jobs.db` si la crea el) nace 0600.
# La validacion de arranque fail-closed (identidad, propietario, modos, symlinks,
# estado fuera de la release) es OBLIGATORIA: no depende de esta unidad.
#
# El secreto de Neo4j (cuenta de SOLO LECTURA del grafo) se lee DIRECTAMENTE de
# /etc/s9-knowledge/secrets (root:s9knowledge, fichero 0640, directorio 0750; el
# servicio lee y NO escribe). Ya no se copia a /run: la politica SECRET lo
# resuelve con menos piezas. Si falta, la ingesta falla CERRADO y visible
# (GRAPH_OBSERVATION_UNCONFIGURED); `deploy.sh` bloquea antes si falta o no
# cumple la politica.
#
# La configuracion es `worker.env` (EnvironmentFile): S9K_JOBS_DB y
# S9K_V3_REVIEW_PROPOSALS_DIR con el MISMO valor que `viewer.env` (lo exige
# `validate_worker_env`) y la conexion de SOLO LECTURA al grafo.
[Unit]
Description=S9 Knowledge - worker de la cola de jobs
After=network-online.target
Wants=network-online.target
AssertPathExists=/opt/s9-knowledge/current/data-engine
AssertPathExists=/etc/s9-knowledge/worker.env

[Service]
Type=simple
User=s9knowledge
Group=s9knowledge
UMask=0077
NoNewPrivileges=true
# C-7 (ronda 2): sin capabilities, DECLARADO (como el healthcheck); el gate de unidad
# exige este valor vacio y NoNewPrivileges=yes|true con la semantica de ultimo valor.
CapabilityBoundingSet=
WorkingDirectory=/opt/s9-knowledge/current/data-engine
EnvironmentFile=/etc/s9-knowledge/worker.env
ExecStart=/opt/s9-knowledge/current/data-engine/.venv/bin/python /opt/s9-knowledge/current/data-engine/app/jobs/worker.py --loop --sleep-seconds 5 --release-stale-seconds 600 --retry-backoff-seconds 30
Restart=always
RestartSec=5
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
