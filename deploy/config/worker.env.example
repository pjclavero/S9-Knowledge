# Entorno del WORKER de la cola de jobs (Slice 2 · Corte 5).
#
# Destino en el host:  /etc/s9-knowledge/worker.env
# Dueño y permisos:    root:root, 0600
# Lo crea:             UNA PERSONA, a mano. No hay ninguna task de Ansible que
#                      lo genere y no hay ansible-vault en este repositorio.
#
# NO ES `viewer.env`, Y COPIARLO ES EL ERROR FÁCIL. El visor admite la
# contraseña de Neo4j en una variable; el motor (`knowledge_v3/driver_neo4j.py`)
# NO: sólo lee el CAMINO de un fichero privado. Si se copia `viewer.env` tal
# cual, el worker sigue funcionando porque coge el fichero, y el secreto queda
# además en una variable de entorno sin que nada avise.
# `deploy/scripts/validate_deploy.sh::validate_worker_env` lo rechaza.
#
# Sin estas variables el handler `ingest_v3` NO se degrada a "no observar":
# falla cerrado con GRAPH_OBSERVATION_UNCONFIGURED y el job termina en ERROR.

# --- Conexión al grafo ------------------------------------------------------
# Sin valor por defecto a propósito: una URI por defecto es una conexión que
# nadie declaró. Usa bolt+s:// si el servidor exige TLS (y asegúrate de que la
# imagen del worker lleva el truststore del sistema).
S9K_NEO4J_URI=bolt://127.0.0.1:7687

# Cuenta de SÓLO LECTURA. No es una recomendación: es el requisito, y exige
# Neo4j Enterprise (en Community no se puede expresar un rol de sólo lectura).
# El Cypher para crearla está en deploy/README.md.
S9K_NEO4J_USER=s9k_worker_lector

# El CAMINO del secreto, nunca el secreto. El fichero tiene que ser 0600 y
# vivir FUERA de la release (nunca bajo /opt/s9-knowledge/current, que el
# validador rechaza).
S9K_NEO4J_PASSWORD_FILE=/etc/s9-knowledge/secrets/neo4j_worker_password

# --- Opcional ---------------------------------------------------------------
# Sólo si el despliegue no usa la base por defecto. Apuntar a la base
# equivocada no da error: da un catálogo vacío y un plan sin proyección.
#S9K_NEO4J_DATABASE=neo4j

# Cola de trabajos. Tiene que ser EL MISMO fichero que ve el visor, o el worker
# reclamará trabajos de una cola que nadie mira.
#S9K_JOBS_DB=/var/lib/s9-knowledge/jobs/jobs.db

# Almacén de propuestas de revisión: MISMO valor que en viewer.env, o el visor
# dirá "Sin propuestas visibles" sobre una ingesta que sí las produjo.
#S9K_V3_REVIEW_PROPOSALS_DIR=/var/lib/s9-knowledge/reviews-v3/proposals

# NUNCA aquí:
#   S9K_NEO4J_PASSWORD=...   <- el motor la ignora y el secreto queda expuesto
