# viewer.env.example — plantilla VERSIONADA de configuración del visor S9 Knowledge.
#
# La configuración productiva REAL vive en /etc/s9-knowledge/viewer.env (fuera del
# repo, fuera de la release). Esta plantilla NO contiene secretos: la contraseña
# de Neo4j va en un fichero 0600 (…_FILE) y el secreto CSRF lo genera el visor.
#
# Nombres de variables tomados VERBATIM del código (viewer/app/config.py y
# viewer/app/auth/config.py). No inventar variables.
#
# El despliegue BLOQUEA si faltan las variables marcadas [CRÍTICA]
# (`deploy/scripts/validate_deploy.sh::CRITICAL_ENV_VARS`).
#
# B2 (USABLE-V1): copiada TAL CUAL a /etc/s9-knowledge/viewer.env, esta
# plantilla sólo exige cambiar S9K_PUBLIC_BASE_URL (y declarar S9K_TLS_CA_FILE
# si el certificado es de una CA propia). Es la configuración que ejercen los
# GATE A/B del testigo `deploy/tests/test_b2_primera_release.py`.
#
# SIN COMENTARIOS AL FINAL DE LÍNEA: el lector del despliegue toma
# `VAR=valor   # nota` con la nota DENTRO del valor (medido: S9K_AUTH_ENABLED
# se leía como "true                # [CRÍTICA]"), y `EnvironmentFile` de
# systemd tampoco los recorta. Las marcas [CRÍTICA] van en la línea de encima.

# --- Servidor del visor ---
# [CRÍTICA] S9K_VIEWER_HOST y S9K_VIEWER_PORT
S9K_VIEWER_HOST=127.0.0.1
S9K_VIEWER_PORT=8088

# --- Grafo / Neo4j ---
# [CRÍTICA] Proveedor del grafo. De fábrica `not_configured`: VACÍO HONESTO
# (#264, decisión D-MOCK). La pantalla dice que no hay proveedor en vez de
# servir datos de muestra como si fueran reales. `neo4j` cuando haya base;
# `mock` es SOLO demostración explícita, nunca un valor de fábrica.
S9K_GRAPH_PROVIDER=not_configured
S9K_DEFAULT_WORKSPACE=leyenda
S9K_GRAPH_LIMIT=300
# [CRÍTICA] S9K_NEO4J_URI y S9K_NEO4J_USER (se declaran aunque el proveedor
# siga sin configurar: son la dirección por defecto de la instalación).
S9K_NEO4J_URI=bolt://127.0.0.1:7687
S9K_NEO4J_USER=neo4j
# Secreto: NO poner aquí. Al pasar a `neo4j`, crear el fichero 0600 en el host
# y descomentar (el despliegue valida existencia y permisos si se declara):
#S9K_NEO4J_PASSWORD_FILE=/etc/s9-knowledge/secrets/neo4j_password
#S9K_NEO4J_PASSWORD=

# --- Estado externo (state root) ---
# [CRÍTICA] Rutas absolutas bajo el state root; nunca bajo la release.
S9K_AUTH_DB_PATH=/var/lib/s9-knowledge/auth/auth.db
S9K_JOBS_DB=/var/lib/s9-knowledge/jobs/jobs.db
S9K_BACKUP_DIR=/var/lib/s9-knowledge/backups

# --- Estado de revisión V3 (B2 · H-04, lado deploy) ---
# [CRÍTICA] Las decisiones humanas (review.sqlite3), los planes sellados y la
# cola de propuestas. Sin declarar, visor y motor caen al defecto DENTRO de la
# release y el siguiente despliegue deja de verlos (sin error: H-18). Tienen
# que ser las MISMAS en el entorno del worker. El directorio `reviews-v3` lo
# crea el rol Ansible `common`; `deploy.sh` (paso 6) comprueba por efecto que
# existen, que se escriben y que visor y motor las resuelven igual.
S9K_V3_REVIEW_DATABASE_PATH=/var/lib/s9-knowledge/reviews-v3/review.sqlite3
S9K_V3_REVIEW_PROPOSALS_DIR=/var/lib/s9-knowledge/reviews-v3/proposals

# --- Autenticación ---
# [CRÍTICA]
S9K_AUTH_ENABLED=true
S9K_AUTH_MAX_FAILED_ATTEMPTS=5
S9K_AUTH_LOCK_MINUTES=15
S9K_AUTH_EXPOSE_DOCS=false
# Confiar en cabeceras de proxy (X-Forwarded-For). FALSE por defecto: solo
# poner true si TODOS los accesos pasan por un reverse proxy conocido que
# filtra las cabeceras entrantes y hay una lista de proxies confiables, sin
# acceso directo no confiable. Ver docs/50-deploy-state-continuity.md.
S9K_AUTH_TRUST_PROXY_HEADERS=false
# Secreto CSRF: NO se versiona ningún valor y NO hace falta fijarlo (#248).
# Sin declarar, el visor lo GENERA en el primer arranque y lo persiste 0600
# junto a la auth DB (`viewer/app/auth/csrf_bootstrap.py`); el despliegue lo
# acepta porque S9K_AUTH_DB_PATH es absoluta y está fuera de la release.
# Fijarlo a mano sigue siendo válido y manda (p. ej. varias instancias tras un
# balanceador); entonces la validación rechaza placeholders (change-me,
# default, secret, ...), valores cortos o de baja entropía, y secretos dentro
# de una release. Uno fuerte:  openssl rand -hex 32
#S9K_CSRF_SECRET=

# --- Sesiones ---
S9K_SESSION_COOKIE_NAME=s9k_session
S9K_SESSION_TTL_HOURS=12
S9K_SESSION_IDLE_MINUTES=60
# [CRÍTICA para la cookie CSRF] Default seguro; NO se degrada automáticamente.
# Con true, la cookie CSRF de /setup/admin sale con atributo Secure: sobre HTTP
# plano ningún cliente la devuelve y el POST entra en bucle de 403, así que NO
# se puede crear el primer administrador. La salida NO es poner false aquí (eso
# es un opt-out explícito de laboratorio/desarrollo): la salida es entregar
# HTTPS -> ver S9K_PUBLIC_BASE_URL abajo. El despliegue BLOQUEA la combinación
# `true` + URL pública HTTP (validate_deploy.sh::validate_https_contract).
S9K_SESSION_SECURE=true
S9K_SESSION_SAMESITE=lax
S9K_SESSION_HTTPONLY=true

# --- Vía HTTPS pública (PR-3, USABLE-V1) ---
# [CRÍTICA en production] URL por la que se alcanza esta instalación DESDE
# FUERA. No es la de escucha del visor (S9K_VIEWER_HOST/PORT, que es loopback
# detrás del terminador TLS): es la que el operador abre en el navegador para
# llegar a /setup/admin.
#
# Tiene que ser https://. `deploy/scripts/preflight_https.py` la verifica POR
# EFECTO (certificado + nombre + que el endpoint CONTESTE) y el despliegue se
# niega a llamarse completo si no verifica.
S9K_PUBLIC_BASE_URL=https://cambiar.por.el.nombre.real
#
# Almacén de confianza DECLARADO. Vacío = el del sistema (CA pública). Si la
# instalación usa una CA propia o un certificado autofirmado, se acepta
# DECLARÁNDOLO aquí; la verificación nunca se desactiva.
#S9K_TLS_CA_FILE=/etc/s9-knowledge/tls/ca.pem

# --- Healthchecks ---
S9K_HEALTH_VIEWER_URL=http://127.0.0.1:8088
S9K_HEALTH_REPORT_PATH=/var/lib/s9-knowledge/health/health.json
S9K_HEALTH_UNITS=s9-knowledge-viewer.service
S9K_HEALTH_DISK_PATH=/var/lib/s9-knowledge

# --- Paginación / límites del visor ---
S9K_VIEWER_DEFAULT_PAGE_SIZE=50
S9K_VIEWER_MAX_PAGE_SIZE=200
S9K_VIEWER_QUERY_TIMEOUT_SECONDS=10
S9K_VIEWER_MAX_SEARCH_LENGTH=200
