# ensayo-rc.env.example — configuracion DECLARADA del ensayo del recorrido real.
#
# Plantilla versionada. La configuracion del ensayo vive FUERA del repositorio
# (`/etc/s9-knowledge/ensayo-rc.env`, modo 0640, propietario del servicio).
#
# NO CONTIENE NI UN SECRETO, y no puede contenerlo: los valores sensibles se
# resuelven por FICHERO (`…_FILE`, modo 0600). Orden correcto y unico:
#   gestor de secretos -> fichero 0600 -> stdin -> variable efimera.
# Un secreto en `argv`, en un log, en un test, en la UI o en un error HTTP es
# un secreto filtrado, aunque nadie lo lea.
#
# NO LLEVA TOPOLOGIA. Ni direcciones, ni nombres de maquina, ni identificadores
# de VM: este repositorio es PUBLICO y ya hubo un incidente por eso. Los
# valores de host van como marcador `<...>` y se rellenan en el servidor.
#
# Se comprueba con:  python3 deploy/scripts/preflight_ensayo_rc.py --workspace <ws>
# Solo el codigo de salida 0 autoriza a empezar. PENDIENTE no autoriza nada.

# --- Identidad del ensayo ---------------------------------------------------
# El commit EXACTO sobre el que se ensaya. El preflight lo compara con el HEAD
# real del arbol: un ensayo sobre el arbol equivocado juzga un producto que no
# es el que se va a desplegar, y desde fuera se lee igual que uno bueno.
S9K_ENSAYO_COMMIT=
# El MISMO valor en los tres sitios. Si el visor pinta un workspace y el writer
# puede escribir en otro, el ensayo lee en uno y escribe en otro sin que se note.
S9K_DEFAULT_WORKSPACE=ensayo-rc
S9K_WRITER_WORKSPACE=ensayo-rc

# --- Estado persistente -----------------------------------------------------
# Un solo sitio del que hablar al reiniciar y al hacer copia. NADA de esto
# puede vivir bajo el arbol de la release: un redespliegue se llevaria por
# delante la cola de revision y las decisiones humanas.
S9K_STATE_ROOT=/var/lib/s9-knowledge/ensayo-rc
# Compartido entre el visor que lo pinta y el motor que lo lee. Es EL invariante
# del Corte 2: separar los volumenes devuelve el falso exito por despliegue.
S9K_V3_REVIEW_DATABASE_PATH=/var/lib/s9-knowledge/ensayo-rc/reviews-v3/review.sqlite3
# Compartido entre el WORKER que escribe las propuestas y el VISOR que las lee.
# Apuntarlo a algo inexistente daba consola vacia y muda (Corte 3).
S9K_V3_REVIEW_PROPOSALS_DIR=/var/lib/s9-knowledge/ensayo-rc/reviews-v3/proposals
# Estado durable del escaner: reiniciar NO debe reprocesarlo todo.
# PENDIENTE DE QUE EL ESCANER EXISTA. Declarado aqui para que el requisito no
# se descubra despues del primer reinicio.
#S9K_SCANNER_STATE_PATH=/var/lib/s9-knowledge/ensayo-rc/scanner/visto.sqlite3

# --- Paso 1: las fuentes ----------------------------------------------------
# REAL y POBLADO. Vacio, el paso 1 deja de ser usable SIN dar ni un error.
S9K_INGEST_SOURCES_DIR=/var/lib/s9-knowledge/ensayo-rc/fuentes

# --- Los huecos del chasis, por LETRA ---------------------------------------
# Fail closed: se sirven si y solo si valen exactamente `true` o `1`. Escritos
# con el NOMBRE del hueco (S9K_PANEL_REVIEW_ENABLED) no montan nada, y la
# pantalla no distingue «apagado» de «no autorizado».
S9K_PANEL_B_ENABLED=true          # Operaciones: alta de fuente y lanzamiento
S9K_PANEL_C_ENABLED=true          # Review: cola de propuestas y decision humana
S9K_PANEL_F_ENABLED=true          # Sources: catalogo de fuentes
S9K_PANEL_G_ENABLED=true          # Entities: resultado navegable
S9K_PANEL_RESULTADO_ENABLED=true  # resultado -> procedencia -> evidencia literal

# --- Autoridad de revision --------------------------------------------------
S9K_AUTH_ENABLED=true

# --- Para que el boton de APLICAR exista ------------------------------------
# `v3_apply` exige EXACTAMENTE "1". Con cualquier otra cosa la pantalla no
# ofrece el boton y el POST contesta APPLY_NOT_ENABLED.
S9K_ALLOW_REAL_INGEST=1

# --- El grafo: el worker tiene que PODER OBSERVARLO -------------------------
S9K_GRAPH_PROVIDER=neo4j
# Local, o cifrado con CA verificada. `+ssc` NO: acepta autofirmados sin
# verificar, que es una ruta de repuesto silenciosa.
S9K_NEO4J_URI=bolt://127.0.0.1:7687
#S9K_NEO4J_URI=neo4j+s://<host-del-grafo>:7687
#S9K_NEO4J_CA_FILE=/etc/s9-knowledge/secrets/neo4j_ca.pem
# MINIMO PRIVILEGIO: usuario propio del ensayo, NUNCA el administrador `neo4j`,
# con permiso de lectura/escritura acotado al workspace del ensayo.
S9K_NEO4J_USER=s9k_ensayo_rc
# El secreto va en un fichero 0600 fuera del repositorio. `S9K_NEO4J_PASSWORD`
# en el entorno del proceso es un defecto, no una alternativa.
S9K_NEO4J_PASSWORD_FILE=/etc/s9-knowledge/secrets/neo4j_password_ensayo
